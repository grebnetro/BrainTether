datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String      @id @default(cuid())
  name                  String?
  email                 String?     @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  therapistAccessCode   String?     @unique @default("BT-772-MIND")
  dailyStressCeiling    Int         @default(30)
  defaultSoundscape     String      @default("rain")
  hasCompletedOnboarding Boolean    @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  accounts              Account[]
  sessions              Session[]
  tasks                 Task[]
  habits                Habit[]
  moodLogs              MoodLog[]
  bodyDoublingSessions  BodyDoublingSession[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String   @default("General")
  targetDate  DateTime?
  color       String   @default("#14b8a6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
}

model Task {
  id               String   @id @default(cuid())
  userId           String
  goalId           String?
  title            String
  description      String?
  status           String   @default("TODO") // TODO, IN_PROGRESS, WAITING, COMPLETED
  priority         String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  stressPoints     Int      @default(5) // 1 (low avoidance) to 10 (paralyzing avoidance)
  category         String   @default("General") // Household, Money, Self-Care, Work, Health
  dueDate          DateTime?
  assignedPartnerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Habit {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  targetDays     Int      @default(21) // ADHD 21-day streak milestone
  currentStreak  Int      @default(0)
  completedDates String   @default("[]") // JSON string of dates
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodLog {
  id          String   @id @default(cuid())
  userId      String
  energyLevel Int      // 1 (drained) to 5 (vibrant)
  stressLevel Int      // 1 (calm) to 10 (overwhelmed)
  moodTag     String   // e.g. "Focus", "Anxious", "Calm", "Burnout"
  notes       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyDoublingSession {
  id          String   @id @default(cuid())
  userId      String
  partnerName String   @default("Sarah M.")
  partnerAvatar String @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150")
  status      String   @default("ACTIVE") // IDLE, ACTIVE, COMPLETED
  soundscape  String   @default("rain") // rain, brown, ocean, none
  startedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
